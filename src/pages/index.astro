---
import { getArticles } from '../lib/articles';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import AdSlot from '../components/AdSlot.astro';
const articles = await getArticles();
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured?.id).slice(0, 4);
const topics = [...new Set(articles.map((article) => article.data.topic))];
---
<BaseLayout>
  <main>
    <section class="hero">
      <div class="hero-copy"><p class="eyebrow">AI-assisted research journal</p><h1>把複雜的研究，<em>讀成自己的。</em></h1><p class="hero-lede">article.ai 將論文、技術報告與重要資訊，整理成有脈絡、可驗證、適合慢慢讀的文章。</p><div class="hero-actions"><a class="button button--dark" href="#latest">開始閱讀 <span>↓</span></a><a class="text-link" href="#method">了解我們怎麼分析 <span>↗</span></a></div></div>
      <div class="hero-note"><span class="note-number">01</span><p>每篇文章都會標示<br /><strong>證據強度</strong>與來源數量。</p><div class="note-line"></div><span class="note-small">閱讀不是找到答案<br />而是知道答案有多可靠。</span></div>
    </section>
    {featured && <section class="featured-section"><SectionLabel eyebrow="本週主題" title="值得先讀" /><ArticleCard article={featured} featured /></section>}
    <AdSlot placement="top" />
    <section class="latest-section" id="latest"><SectionLabel eyebrow="編輯室" title="最新分析" href="#topics" linkText="依主題瀏覽" /><div class="article-grid">{latest.map((article) => <ArticleCard article={article} />)}</div></section>
    <AdSlot placement="mid" />
    <section class="topic-section" id="topics"><SectionLabel eyebrow="探索" title="從你關心的問題開始" /><div class="topic-grid">{topics.map((topic, index) => <a class="topic-tile" href={`#topic-${index}`}><span>0{index + 1}</span><strong>{topic}</strong><small>{articles.filter((article) => article.data.topic === topic).length} 篇文章 ↗</small></a>)}</div></section>
    <section class="method-section" id="method"><div><span class="eyebrow">我們的方法</span><h2>AI 幫你讀得更快，<br /><em>但判斷仍然要慢。</em></h2></div><div class="method-copy"><p>我們使用 AI 協助摘要、比對來源與找出文章之間的關聯，再由人重新檢查脈絡與限制。</p><div class="method-steps"><div><b>01</b><span>拆解問題</span></div><div><b>02</b><span>追溯證據</span></div><div><b>03</b><span>保留不確定</span></div></div></div></section>
  </main>
</BaseLayout>
