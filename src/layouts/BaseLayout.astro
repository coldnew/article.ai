---
import Analytics from '../components/Analytics.astro';
import MonetizationScripts from '../components/MonetizationScripts.astro';
import '../styles/global.css';
const { title = 'article.ai — 讓複雜的研究變得可讀', description = '用 AI 協助閱讀論文、拆解證據，整理成值得反覆回看的研究文章。' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body><div class="site-shell"><slot /><MonetizationScripts /></div></body>
</html>
